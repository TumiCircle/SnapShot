{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "PixelSnap",
  "version": "1.0.0",
  "identifier": "com.pixelsnap.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PixelSnap",
        "width": 440,
        "height": 720,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#0a0818",
        "url": "index.html",
        "label": "main",
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
